//@version=6
// =============================================================================
//  ZENITH SUITE V19 -- Instrument Edition
//  Espejo 1:1 de lo que el bot decide hoy: instrument/rules.py + geometry.py
//  + el enfriamiento de main.py.  Repo scalp_bot @ 459974c (2026-08-21).
//
//  QUE CAMBIO CONTRA V18 (y por que):
//   | V18 pintaba 4 estrategias (V1-LONG, V1-SHORT, V3-REV, V4-EMA). Ninguna
//     se midio nunca contra velas reales. El instrumento las midio y solo
//     UNA quedo viva: el pullback en tendencia. Las demas no estan aqui.
//   | V18 usaba SL 2.0xATR / TP1 2.0R / TP2 3.5R / TP3 7.0R. Medido: de 59
//     trades solo 7 tocaron TP1 y la MFE mediana fue +0.67R -- el objetivo
//     estaba puesto mas alla de donde el precio llega. V19 usa la geometria
//     que salio de esa medicion: SL 1.5xATR, TP1 0.7R, TP2 1.3R.
//   | V18 solo dibujaba lo que disparaba. V19 dibuja tambien lo que el bot
//     SUPRIME, y por que gate exacto -- que es lo que el bot viejo nunca
//     supo decir.
//   | La ruptura (Donchian + expansion) se RETIRO el 2026-08-21: +0.014R
//     contra su propio baseline sin filtro de +0.026R, a 16 alertas/semana.
//     El filtro quitaba valor. No esta aqui tampoco.
//
//  HONESTIDAD (leelo antes de operar con esto):
//   El pullback midio +0.146R con n=107 sobre 2 anios y 6 simbolos, ~1.0
//   alerta/semana, contra un baseline sin filtro de -0.006R. PERO su IC es
//   [-0.008, +0.301] -- cruza cero -- y en 4h se vuelve NEGATIVO (-0.039R,
//   n=32). Es un CANDIDATO, no un resultado. El bot lo trata asi.
// =============================================================================
indicator("Zenith V19 | Instrument", overlay=true, max_lines_count=60, max_labels_count=120, max_boxes_count=20)

// =============================================================================
// INPUTS -- los umbrales son valores de libro de texto, NO ajustados a este
// corpus. Una busqueda de 1,296 configuraciones ajustadas paso de +0.382R en
// calibracion a -0.341R fuera de muestra. Por eso no se tocan a ojo.
// =============================================================================
g_rule = "Regla (rules.py -- no ajustar a ojo)"
rsi_len       = input.int(14,    "RSI Period",        group=g_rule)
atr_len       = input.int(14,    "ATR Period",        group=g_rule)
ema_len       = input.int(200,   "EMA Period (sesgo)",group=g_rule)
bb_len        = input.int(20,    "BB Period",         group=g_rule)
bb_k          = input.float(2.0, "BB K",              group=g_rule, step=0.1)
adx_len       = input.int(14,    "ADX Period",        group=g_rule)
rsi_oversold  = input.float(30.0,"RSI sobreventa",    group=g_rule, step=1.0)
rsi_overbought= input.float(70.0,"RSI sobrecompra",   group=g_rule, step=1.0)
bb_pctb_low   = input.float(0.2, "BB %B piso",        group=g_rule, step=0.05)
bb_pctb_high  = input.float(0.8, "BB %B techo",       group=g_rule, step=0.05)
adx_min       = input.float(25.0,"ADX minimo",        group=g_rule, step=1.0)
atr_min_pct   = input.float(0.4, "ATR minimo %",      group=g_rule, step=0.1) / 100.0

g_geo = "Geometria (geometry.py -- salida de 59 trades medidos)"
sl_atr_mult = input.float(1.5, "SL = ATR x", group=g_geo, step=0.1)
tp1_r       = input.float(0.7, "TP1 = R x",  group=g_geo, step=0.1)
tp2_r       = input.float(1.3, "TP2 = R x",  group=g_geo, step=0.1)
partial_tp1 = input.float(0.5, "Parcial en TP1", group=g_geo, step=0.1, minval=0.0, maxval=1.0)

g_side = "Que lados operar"
sides_in = input.string("Auto (acciones: solo LONG)", "Lados permitidos", options=["Auto (acciones: solo LONG)", "Ambos", "Solo LONG", "Solo SHORT"], group=g_side, tooltip="Medido 2026-08-23 sobre 2 anios y 29 acciones: LONG +0.216R (n=138, IC [+0.071,+0.362], positivo en las dos mitades) contra un baseline sin filtros de +0.026R. SHORT -0.012R con n=130: no aporta nada. En cripto la muestra es n=26 y no alcanza para decidir, por eso Auto no restringe cripto.")

g_cool = "Enfriamiento (main.py::_in_cooldown)"
max_hold_bars = input.int(72, "Velas de enfriamiento por lado", group=g_cool, minval=1)
use_cooldown  = input.bool(true, "Aplicar enfriamiento", group=g_cool)

g_evt = "Ventana de evento (FOMC +/-24h)"
use_fomc  = input.bool(false, "Suprimir cerca del FOMC", group=g_evt)
fomc_time = input.time(timestamp("2026-09-16T18:00:00+0000"), "Fecha FOMC (UTC)", group=g_evt)
fomc_hrs  = input.int(24, "Ventana +/- horas", group=g_evt)

g_vis = "Visual"
show_panel      = input.bool(true, "Panel del instrumento", group=g_vis)
show_record     = input.bool(true, "Incluir el historial medido", group=g_vis, tooltip="Apagarlo deja solo estado y geometria: el panel pasa de 13 filas a 8 y tapa menos precio. Los numeros siguen en docs/PINE_SCRIPT_GUIDE.md.")
show_gates      = input.bool(true, "Panel de gates",        group=g_vis)
panel_pos_in    = input.string("Arriba derecha", "Donde va el panel", options=["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda", "Media derecha", "Media izquierda"], group=g_vis)
gates_pos_in    = input.string("Abajo derecha",  "Donde van los gates", options=["Abajo derecha", "Abajo izquierda", "Arriba derecha", "Arriba izquierda", "Media derecha", "Media izquierda"], group=g_vis)
show_levels     = input.bool(true, "Dibujar SL/TP",         group=g_vis)
show_suppressed = input.bool(true, "Marcar SUPRIMIDAS",     group=g_vis)

// =============================================================================
// INDICADORES -- portados bar-a-bar desde instrument/ta.py.
// Ojo: ta.py suaviza Wilder arrancando en 0 (no sembrado con SMA) y publica
// solo despues del warmup. ta.rsi/ta.atr/ta.adx nativos de Pine siembran con
// SMA y derivan unas decimas. Se replica la recursion a mano para que la vela
// que ves marcada sea la misma vela que el bot marca.
// =============================================================================
f_rma0(src, len) =>
    var float s = 0.0
    s := (1.0 / len) * src + (1.0 - 1.0 / len) * nz(s[1])
    s

f_tr() =>
    bar_index == 0 ? high - low : math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))

f_rsi0(len) =>
    float delta = bar_index == 0 ? 0.0 : close - close[1]
    float ag = f_rma0(delta > 0 ? delta : 0.0, len)
    float al = f_rma0(delta < 0 ? -delta : 0.0, len)
    float v = al == 0 ? 50.0 : 100.0 - 100.0 / (1.0 + ag / al)
    bar_index >= len ? v : na

f_atr0(len) =>
    float v = f_rma0(f_tr(), len)
    bar_index >= len ? v : na

f_adx0(len) =>
    float up = bar_index == 0 ? 0.0 : high - high[1]
    float dn = bar_index == 0 ? 0.0 : low[1] - low
    float pdm = (up > dn and up > 0) ? up : 0.0
    float mdm = (dn > up and dn > 0) ? dn : 0.0
    float tra = f_rma0(f_tr(), len)
    float pda = f_rma0(pdm, len)
    float mda = f_rma0(mdm, len)
    float pdi = tra != 0 ? 100.0 * pda / tra : 0.0
    float mdi = tra != 0 ? 100.0 * mda / tra : 0.0
    float dsum = pdi + mdi
    float dx = dsum != 0 ? 100.0 * math.abs(pdi - mdi) / dsum : 0.0
    float dxa = f_rma0(dx, len)
    bar_index >= len * 2 ? dxa : na

float rsi_v  = f_rsi0(rsi_len)
float atr_v  = f_atr0(atr_len)
float ema200 = ta.ema(close, ema_len)
float bb_mid = ta.sma(close, bb_len)
float bb_sd  = ta.stdev(close, bb_len)
float bb_up  = bb_mid + bb_k * bb_sd
float bb_lo  = bb_mid - bb_k * bb_sd
float adx_v  = f_adx0(adx_len)
float pctb   = bb_up > bb_lo ? (close - bb_lo) / (bb_up - bb_lo) : na

bool warm = not na(rsi_v) and not na(atr_v) and not na(ema200) and not na(bb_up) and not na(adx_v)

// =============================================================================
// DECISION -- mismo orden que rules.py::evaluate: sesgo, evento, gates, geometria.
// =============================================================================
bool is_long  = warm and close > ema200
bool is_short = warm and close < ema200
bool tie      = warm and close == ema200

bool in_fomc = use_fomc and math.abs(time - fomc_time) <= fomc_hrs * 3600000

bool g_rsi = is_long ? rsi_v <= rsi_oversold : rsi_v >= rsi_overbought
bool g_bb  = not na(pctb) and (is_long ? pctb <= bb_pctb_low : pctb >= bb_pctb_high)
bool g_adx = adx_v >= adx_min
bool g_atr = close != 0 and (atr_v / close) >= atr_min_pct
bool gates_ok = g_rsi and g_bb and g_adx and g_atr

float r_unit = na(atr_v) ? na : sl_atr_mult * atr_v
float sl_px  = is_long ? close - r_unit : close + r_unit
float tp1_px = is_long ? close + tp1_r * r_unit : close - tp1_r * r_unit
float tp2_px = is_long ? close + tp2_r * r_unit : close - tp2_r * r_unit

// assert_geometry: mismas condiciones que geometry.py. Con ATR>0 nunca deberia
// fallar; se conserva porque 22 de las 92 filas del bot viejo no la pasaban.
bool geo_ok = not na(r_unit) and r_unit > 0 and sl_px > 0 and tp1_px > 0 and tp2_px > 0 and (is_long ? (sl_px < close and close < tp1_px and tp1_px <= tp2_px) : (sl_px > close and close > tp1_px and tp1_px >= tp2_px))

// ---------------------------------------------------------------------------
// Gate de lado. No es un umbral afinado a ojo: en 2 anios y 29 acciones el LONG
// dio +0.216R (n=138) con el IC entero por encima de cero y el signo aguantando
// en las dos mitades, mientras el SHORT dio -0.012R con n=130 -- indistinguible
// de nada. Tiene mecanismo: comprar retrocesos aprovecha la deriva alcista
// estructural de las acciones; vender rebotes pelea contra ella.
// En cripto NO se restringe: alli la muestra es n=26 (12 LONG / 14 SHORT) y
// recortar un lado con esa evidencia seria justo el ajuste a ojo que este
// indicador existe para no repetir.
// ---------------------------------------------------------------------------
bool is_equity = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr"
bool side_ok = sides_in == "Ambos" ? true : sides_in == "Solo LONG" ? is_long : sides_in == "Solo SHORT" ? is_short : (is_equity ? is_long : true)

bool raw_fire = warm and not tie and not in_fomc and side_ok and gates_ok and geo_ok

// Enfriamiento: un aviso por episodio, por simbolo y lado. El 19-ago la regla
// disparo 5 veces sobre la MISMA subida de ETH -- eso es un trade contado cinco
// veces, la misma autocorrelacion que evaporo una ventaja de +0.110R.
var int last_long_bar  = na
var int last_short_bar = na
int last_same = is_long ? last_long_bar : last_short_bar
bool cooling = use_cooldown and not na(last_same) and (bar_index - last_same) < max_hold_bars

bool fired = raw_fire and not cooling
if fired and barstate.isconfirmed
    if is_long
        last_long_bar := bar_index
    else
        last_short_bar := bar_index

string state = not warm ? "CALENTANDO" : tie ? "SUPRIMIDA" : in_fomc ? "SUPRIMIDA" : not side_ok ? "SUPRIMIDA" : not gates_ok ? "SUPRIMIDA" : not geo_ok ? "BLOQUEADA" : cooling ? "SUPRIMIDA" : "ENVIADA"

string reason = not warm ? "sin historia suficiente" : tie ? "close == ema200: sin sesgo" : in_fomc ? "ventana de evento: FOMC" : not side_ok ? "lado no habilitado en este mercado" : cooling and gates_ok and geo_ok ? "enfriamiento: mismo episodio ya aviso" : not geo_ok and gates_ok ? "geometria invalida" : not gates_ok ? "fallo: " + (g_rsi ? "" : "rsi_extreme ") + (g_bb ? "" : "bb_confluence ") + (g_adx ? "" : "adx_trending ") + (g_atr ? "" : "atr_min") : "paso los 4 gates"

// =============================================================================
// CONTEXTO -- el chart contra el corpus donde la regla se midio.
// =============================================================================
string base = syminfo.basecurrency
bool in_corpus = base == "ZEC" or base == "TAO" or base == "BTC" or base == "ETH" or base == "SOL" or base == "BNB"
bool tf_ok = timeframe.period == "60"

// =============================================================================
// PLOTS
// =============================================================================
plot(ema200, "EMA 200", color=close > ema200 ? color.new(color.teal, 40) : color.new(color.maroon, 40), linewidth=2)
p_up = plot(bb_up, "BB Sup", color=color.new(color.gray, 75))
p_lo = plot(bb_lo, "BB Inf", color=color.new(color.gray, 75))
fill(p_up, p_lo, color=color.new(color.gray, 94))

plotshape(fired and is_long,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.teal, 0),    size=size.normal)
plotshape(fired and is_short, "SHORT", shape.triangledown, location.abovebar, color.new(color.maroon, 0),  size=size.normal)
// Lo que el bot vio y NO aviso. El bot viejo solo dibujaba lo que disparaba, y por eso
// nunca supo decir cuantas veces miro y paso de largo.
plotshape(show_suppressed and raw_fire and cooling, "Enfriada", shape.xcross, location.top, color.new(color.orange, 20), size=size.tiny)
plotshape(show_suppressed and warm and not tie and not in_fomc and g_rsi and g_bb and not (g_adx and g_atr), "Casi (falta ADX/ATR)", shape.circle, location.bottom, color.new(color.gray, 45), size=size.tiny)

var line ln_sl = na
var line ln_t1 = na
var line ln_t2 = na
if show_levels and fired and barstate.isconfirmed
    line.delete(ln_sl)
    line.delete(ln_t1)
    line.delete(ln_t2)
    ln_sl := line.new(bar_index, sl_px,  bar_index + max_hold_bars, sl_px,  color=color.new(color.red, 20),   width=1, style=line.style_dashed)
    ln_t1 := line.new(bar_index, tp1_px, bar_index + max_hold_bars, tp1_px, color=color.new(color.green, 20), width=1)
    ln_t2 := line.new(bar_index, tp2_px, bar_index + max_hold_bars, tp2_px, color=color.new(color.green, 55), width=1, style=line.style_dotted)

// =============================================================================// PANELES
// El panel viejo decia "fallo: rsi_extreme bb_confluence". Eso es un diagnostico de
// ingeniero: nombra el gate que no paso y deja al operador traduciendo. Lo que hace
// falta antes de arriesgar dinero es otra cosa -- entro o no entro, por que, que falta
// exactamente, y a que precio esto se armaria. Eso es lo que arma esta seccion.
// =============================================================================
// Punto de equilibrio real: la mitad sale en TP1 y el resto corre con el stop
// en entrada. Guardar el numero "todo en TP1" hacia que la alerta dijera "vas
// ganando" contra un piso hasta 15 puntos mas bajo del que de verdad aplica.
float won   = partial_tp1 * tp1_r
float be_hi = 1.0 / (1.0 + won)
float be_lo = 1.0 / (1.0 + won + (1.0 - partial_tp1) * tp2_r)

color PANEL_BG = color.rgb(14, 17, 24)   // solido: el panel se lee sobre las velas

// Cualquier posicion tapa velas -- el panel vive sobre el grafico. Se elige, no
// se adivina: donde estorbe menos depende de por donde ande el precio ese dia.
f_pos(sel) =>
    sel == "Arriba izquierda" ? position.top_left : sel == "Abajo derecha" ? position.bottom_right : sel == "Abajo izquierda" ? position.bottom_left : sel == "Media derecha" ? position.middle_right : sel == "Media izquierda" ? position.middle_left : position.top_right

// ---------------------------------------------------------------------------
// Cuantas de las cuatro condiciones estan puestas. Es la medida de "que tan
// cerca", y no todas pesan igual: ADX y ATR describen el CONTEXTO (hay tendencia,
// se mueve lo suficiente) y no dependen de donde este el precio ahora mismo. RSI
// y banda describen el PRECIO. Con el contexto puesto, lo unico que falta es que
// el precio venga -- ese es el caso que merece que el operador se quede mirando.
// ---------------------------------------------------------------------------
int gates_set = (g_rsi ? 1 : 0) + (g_bb ? 1 : 0) + (g_adx ? 1 : 0) + (g_atr ? 1 : 0)
bool ctx_ready = g_adx and g_atr          // contexto listo, falta el precio
bool armed = warm and not tie and not in_fomc and ctx_ready and not (g_rsi and g_bb)

// Ultima vez que ESTE grafico marco una senal. Sin esto, "no entrar" doce dias
// seguidos se lee igual que un indicador roto -- y a ~1 alerta por semana repartida
// entre seis simbolos, callar es el comportamiento normal, no una falla.
var int last_fire_bar = na
if fired and barstate.isconfirmed
    last_fire_bar := bar_index

f_ago(float bars) =>
    na(bars) ? "nunca en este grafico" : bars < 24 ? str.tostring(bars, "#") + " velas" : str.tostring(math.round(bars / 24.0)) + " dias"

// El precio al que esto se armaria: la banda que el gate de %B pide tocar. Es
// aproximado a proposito y se dice -- la banda se mueve con cada vela nueva.
float trigger_px = is_long ? bb_lo : bb_up
float trigger_dist = close != 0 ? (trigger_px - close) / close * 100.0 : na

// ---------------------------------------------------------------------------
// El veredicto, en el idioma en el que se opera.
// ---------------------------------------------------------------------------
string verdict = not warm ? "ESPERA" : not side_ok ? "NO ENTRAR" : state == "ENVIADA" ? (is_long ? "ENTRAR LONG" : "ENTRAR SHORT") : state == "BLOQUEADA" ? "NO ENTRAR" : armed ? "VIGILA" : "NO ENTRAR"

color verdict_bg = verdict == "ENTRAR LONG" ? color.rgb(19, 115, 102) : verdict == "ENTRAR SHORT" ? color.rgb(140, 38, 45) : verdict == "VIGILA" ? color.rgb(150, 104, 20) : color.rgb(62, 68, 82)

string why = not warm ? "Faltan velas para que los indicadores signifiquen algo" : not side_ok and is_equity ? "En acciones el SHORT midio -0.012R con n=130: no aporta. Aqui solo se compran retrocesos" : not side_ok ? "Este lado esta apagado en los ajustes" : tie ? "El precio esta sobre la EMA200: sin lado definido" : in_fomc ? "Ventana FOMC: el bot no opera cerca de la reunion" : state == "ENVIADA" ? "Retroceso dentro de la tendencia, las cuatro puestas" : cooling ? "Ya avise de este movimiento; una segunda no es informacion nueva" : not g_adx and not g_atr ? "Mercado lateral y quieto: ni tendencia ni recorrido" : not g_adx ? "No hay tendencia que seguir, esto es rango" : not g_atr ? "Se mueve muy poco: el stop no cabe" : is_long ? "Tendencia alcista, pero el precio va estirado arriba -- no hay retroceso que comprar" : "Tendencia bajista, pero el precio va estirado abajo -- no hay rebote que vender"

string missing = state == "ENVIADA" ? "nada, esta puesta" : not side_ok ? "que el precio cruce al otro lado de la EMA200" : not g_rsi and not g_bb ? (is_long ? "que el precio baje: RSI a 30 y tocar la banda de abajo" : "que el precio suba: RSI a 70 y tocar la banda de arriba") : not g_rsi ? (is_long ? "que el RSI baje a 30" : "que el RSI suba a 70") : not g_bb ? (is_long ? "que el precio toque la banda de abajo" : "que el precio toque la banda de arriba") : not g_adx ? "que se forme tendencia (ADX 25)" : not g_atr ? "que el rango se abra (ATR 0.4%)" : "-"

var table pnl = table.new(f_pos(panel_pos_in), 2, 18, border_width=1)
if show_panel and barstate.islast
    color hdr = color.rgb(0, 0, 0)
    table.cell(pnl, 0, 0, "ZENITH V19", bgcolor=hdr, text_color=color.white, text_size=size.small)
    table.cell(pnl, 1, 0, base + " | " + timeframe.period, bgcolor=hdr, text_color=color.white, text_size=size.small)

    table.cell(pnl, 0, 1, "QUE HAGO", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 1, verdict, bgcolor=verdict_bg, text_color=color.white, text_size=size.normal)
    table.cell(pnl, 0, 2, "Por que", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 2, why, bgcolor=PANEL_BG, text_color=color.silver, text_size=size.tiny)
    table.cell(pnl, 0, 3, "Falta", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 3, str.tostring(gates_set) + " de 4 puestas: " + missing, bgcolor=PANEL_BG, text_color=color.white, text_size=size.tiny)

    string arm_txt = state == "ENVIADA" ? "ahora" : na(trigger_px) ? "-" : str.tostring(trigger_px, format.mintick) + "  (" + str.tostring(trigger_dist, "#.#") + "% de aqui, aprox)"
    table.cell(pnl, 0, 4, "Se arma cerca de", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 4, arm_txt, bgcolor=PANEL_BG, text_color=armed ? color.orange : color.silver, text_size=size.tiny)
    table.cell(pnl, 0, 5, "Ultima senal aqui", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 5, f_ago(bar_index - last_fire_bar) + "  (normal: ~1/semana entre 6 simbolos)", bgcolor=PANEL_BG, text_color=color.silver, text_size=size.tiny)

    table.cell(pnl, 0, 6, "SI ENTRA", bgcolor=color.rgb(48, 54, 66), text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 1, 6, is_long ? "LONG" : "SHORT", bgcolor=color.rgb(48, 54, 66), text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 0, 7, "Entrada", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 7, str.tostring(close, format.mintick), bgcolor=PANEL_BG, text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 0, 8, "Stop (1R)", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 8, str.tostring(sl_px, format.mintick) + "  (" + str.tostring((sl_px - close) / close * 100, "#.##") + "%)", bgcolor=PANEL_BG, text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 0, 9, "TP1 / TP2", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 9, str.tostring(tp1_px, format.mintick) + "  /  " + str.tostring(tp2_px, format.mintick), bgcolor=PANEL_BG, text_color=color.white, text_size=size.tiny)
    table.cell(pnl, 0, 10, "Aciertos p/ no perder", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, 10, str.tostring(be_lo * 100, "#.#") + "% - " + str.tostring(be_hi * 100, "#.#") + "%", bgcolor=PANEL_BG, text_color=color.orange, text_size=size.tiny)

    int ctx_row = show_record ? 16 : 11
    if show_record
        table.cell(pnl, 0, 11, "MEDIDO", bgcolor=color.rgb(48, 54, 66), text_color=color.white, text_size=size.tiny)
        table.cell(pnl, 1, 11, "2 anios | 6 simbolos", bgcolor=color.rgb(48, 54, 66), text_color=color.white, text_size=size.tiny)
        table.cell(pnl, 0, 12, "Pullback 1h", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
        table.cell(pnl, 1, 12, "+0.146R  n=107  IC[-0.008,+0.301]", bgcolor=PANEL_BG, text_color=color.silver, text_size=size.tiny)
        table.cell(pnl, 0, 13, "vs sin filtro", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
        table.cell(pnl, 1, 13, "-0.006R  |  ~1.0 alerta/sem", bgcolor=PANEL_BG, text_color=color.silver, text_size=size.tiny)
        table.cell(pnl, 0, 14, "En 4h / 1D", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
        table.cell(pnl, 1, 14, "-0.039R (n=32)  /  n=1", bgcolor=PANEL_BG, text_color=color.new(color.orange, 20), text_size=size.tiny)
        table.cell(pnl, 0, 15, "Veredicto", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
        table.cell(pnl, 1, 15, "CANDIDATO, no resultado (IC cruza 0)", bgcolor=PANEL_BG, text_color=color.orange, text_size=size.tiny)

    string ctx = (tf_ok ? "" : "TF " + timeframe.period + " NO medido | usa 1h. ") + (in_corpus ? "" : base + " fuera del corpus (ZEC TAO BTC ETH SOL BNB).")
    table.cell(pnl, 0, ctx_row, "Contexto", bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(pnl, 1, ctx_row, ctx == "" ? "simbolo y marco dentro de lo medido" : ctx, bgcolor=ctx == "" ? color.rgb(19, 115, 102) : color.rgb(140, 38, 45), text_color=color.white, text_size=size.tiny)

// ---------------------------------------------------------------------------
// Las cuatro condiciones, con nombres que se leen y con CUANTO falta. "rsi_extreme
// 73.6 <= 30 no" obliga a restar de cabeza; "le faltan 43.6 puntos" no.
// ---------------------------------------------------------------------------
f_gate_row(t, r, nm, now_s, need_s, gap_s, ok) =>
    table.cell(t, 0, r, nm, bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, r, now_s, bgcolor=PANEL_BG, text_color=color.white, text_size=size.tiny)
    table.cell(t, 2, r, need_s, bgcolor=PANEL_BG, text_color=color.gray, text_size=size.tiny)
    table.cell(t, 3, r, ok ? "-" : gap_s, bgcolor=PANEL_BG, text_color=color.orange, text_size=size.tiny)
    table.cell(t, 4, r, ok ? "OK" : "no", bgcolor=ok ? color.rgb(19, 115, 102) : color.rgb(140, 38, 45), text_color=color.white, text_size=size.tiny)

var table gts = table.new(f_pos(gates_pos_in), 5, 5, border_width=1)
if show_gates and barstate.islast
    color gh = color.rgb(0, 0, 0)
    table.cell(gts, 0, 0, "CONDICION", bgcolor=gh, text_color=color.white, text_size=size.tiny)
    table.cell(gts, 1, 0, "AHORA", bgcolor=gh, text_color=color.white, text_size=size.tiny)
    table.cell(gts, 2, 0, "PIDE", bgcolor=gh, text_color=color.white, text_size=size.tiny)
    table.cell(gts, 3, 0, "LE FALTA", bgcolor=gh, text_color=color.white, text_size=size.tiny)
    table.cell(gts, 4, 0, is_long ? "LONG" : "SHORT", bgcolor=gh, text_color=color.white, text_size=size.tiny)
    f_gate_row(gts, 1, "RSI estirado", str.tostring(rsi_v, "#.#"), is_long ? "<= " + str.tostring(rsi_oversold, "#") : ">= " + str.tostring(rsi_overbought, "#"), str.tostring(math.abs(rsi_v - (is_long ? rsi_oversold : rsi_overbought)), "#.#") + " pts", g_rsi)
    f_gate_row(gts, 2, "Toca la banda", str.tostring(pctb, "#.##"), is_long ? "<= " + str.tostring(bb_pctb_low, "#.##") : ">= " + str.tostring(bb_pctb_high, "#.##"), na(trigger_dist) ? "-" : str.tostring(trigger_dist, "#.#") + "% de precio", g_bb)
    f_gate_row(gts, 3, "Hay tendencia", str.tostring(adx_v, "#.#"), ">= " + str.tostring(adx_min, "#"), str.tostring(math.max(0, adx_min - adx_v), "#.#") + " pts", g_adx)
    f_gate_row(gts, 4, "Se mueve", str.tostring(atr_v / close * 100, "#.##") + "%", ">= " + str.tostring(atr_min_pct * 100, "#.##") + "%", str.tostring(math.max(0, atr_min_pct * 100 - atr_v / close * 100), "#.##") + "%", g_atr)

// La banda que hay que tocar se engrosa cuando el contexto YA esta puesto y lo unico
// que falta es que el precio venga. Deja de ser una linea de adorno y pasa a ser el
// nivel al que hay que volver a mirar.
plot(armed ? trigger_px : na, "Zona de armado", color=color.new(color.orange, 0), linewidth=3, style=plot.style_linebr)

// =============================================================================
// ALERTA -- mismos nombres de campo que la fila de `signals` del instrumento,
// para que lo que suene en TradingView y lo que el bot guarda sean lo mismo.
// El bot NO ejecuta: esto es un aviso para operar a mano.
// =============================================================================
string payload = '{"symbol":"' + base + '","timeframe":"' + timeframe.period + '","side":"' + (is_long ? "LONG" : "SHORT") + '","decision":"SENT","strategy":"pullback","regime":"TREND_PULLBACK","entry_price":' + str.tostring(close) + ',"sl_price":' + str.tostring(sl_px) + ',"tp1_price":' + str.tostring(tp1_px) + ',"tp2_price":' + str.tostring(tp2_px) + ',"r_unit":' + str.tostring(r_unit) + ',"rr_tp1":' + str.tostring(tp1_r) + ',"rr_tp2":' + str.tostring(tp2_r) + ',"rsi":' + str.tostring(rsi_v) + ',"bb_pctb":' + str.tostring(pctb) + ',"adx":' + str.tostring(adx_v) + ',"atr":' + str.tostring(atr_v) + ',"in_corpus":' + (in_corpus ? "true" : "false") + '}'

if fired
    alert(payload, alert.freq_once_per_bar_close)

alertcondition(fired and is_long,  "V19 LONG pullback",  "Zenith V19: pullback LONG")
alertcondition(fired and is_short, "V19 SHORT pullback", "Zenith V19: pullback SHORT")
